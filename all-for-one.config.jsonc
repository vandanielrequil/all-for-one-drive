{
  "replication": 3, // число копий по эшелонам; по умолчанию 3
  "echelon": 1, // самый верхний разрешённый эшелон; всегда 1..3
  "archive": true, // false — загружать обработанные медиафайлы без архивации
  "imageConverter": { // подготовка фотографий; пути относительно этого файла
    "inputDir": "./image-input",
    "outputDir": "./image-output",
    "maxDimension": 2560, // меньшие изображения не увеличиваются
    "quality": 83 // JPEG quality 1–100
  },
  "videoConverter": { // подготовка видео
    "inputDir": "./video-input",
    "outputDir": "./video-output",
    "maxDimension": 2560,
    "quality": 83 // 1–100, маппится в libx264 CRF
  },
  "archiver": { // зашифрованные архивы из результатов конвертации
    "outputDir": "./archive-output",
    "maxArchiveSizeMB": 500 // один большой файл допускается отдельным архивом
  },
  "rclone": {
    "uploadDir": "./upload-output", // staging для загрузки без архивов
    "transfers": 4, // rclone --transfers; по умолчанию 4
    "batchSize": 32, // файлов на один вызов rclone copy; по умолчанию 32
    "providers": [ // provider: echelon 1–3, priority 0–101; accounts[]; rootPath опционален
      // OAuth: Google Drive, Dropbox, OneDrive, Box, pCloud, Yandex, Zoho, Jottacloud, Koofr, Put.io, ShareFile
      // {
      //   "name": "google-drive",
      //   "type": "drive",
      //   "echelon": 1,
      //   "priority": 2, // 1 — первый; 0 отключён; 101 заполнен
      //   "acceptsArchives": true,
      //   "accounts": [{
      //     "name": "personal",
      //     "email": "vandaniel1994usa@gmail.com", // только для человека; программа не использует
      //     "rootPath": "",
      //     "oauth": { "tokenFile": "./google-drive-personal.oauth-token" }, // OAuth один раз; token рядом с конфигом
      //     "options": {
      //       "client_id": "CLIENT_ID",
      //       "client_secret": "CLIENT_SECRET",
      //       "root_folder_id": ""
      //     }
      //   }]
      // },
      // Box.com OAuth; проще без своего Client ID (встроенный rclone client)
      // {
      //   "name": "box",
      //   "type": "box",
      //   "echelon": 3,
      //   "priority": 1,
      //   "acceptsArchives": true,
      //   "maxFileSizeMB": 250, // free: 250 МБ на файл; больше — spillover на другой storage
      //   "accounts": [{
      //     "name": "personal",
      //     "email": "vandaniel1994usa@gmail.com",
      //     "rootPath": "",
      //     "oauth": { "tokenFile": "./box-personal.oauth-token" },
      //     "options": {}
      //   }]
      // },
      // Cloudflare R2 через rclone s3 (не Cloudflare API)
      // {
      //   "name": "cloudflare-r2",
      //   "type": "s3",
      //   "echelon": 1,
      //   "priority": 3,
      //   "acceptsArchives": true,
      //   "maxUsageMB": 9900, // жёсткий потолок по размеру из rclone size
      //   "accounts": [{
      //     "name": "primary",
      //     "email": "vandaniel1994usa@gmail.com",
      //     "rootPath": "all-for-one-bucket",
      //     "options": {
      //       "provider": "Cloudflare",
      //       "access_key_id": "R2_ACCESS_KEY_ID",
      //       "secret_access_key": "R2_SECRET_ACCESS_KEY",
      //       "endpoint": "https://ACCOUNT_ID.r2.cloudflarestorage.com",
      //       "acl": "private"
      //     }
      //   }]
      // },
      // Storj (S3 gateway)
      // {
      //   "name": "storj",
      //   "type": "s3",
      //   "echelon": 2,
      //   "priority": 1,
      //   "acceptsArchives": true,
      //   "accounts": [{
      //     "name": "all-for-one-key",
      //     "email": "vandaniel1994usa@gmail.com",
      //     "rootPath": "all-for-one", // bucket name
      //     "options": {
      //       "provider": "Storj",
      //       "access_key_id": "ACCESS_KEY",
      //       "secret_access_key": "SECRET_KEY",
      //       "endpoint": "https://gateway.storjshare.io"
      //     }
      //   }]
      // },
      // S3 / Wasabi / MinIO / Spaces / Scaleway / Backblaze S3
      // {
      //   "name": "s3-storage",
      //   "type": "s3",
      //   "echelon": 2,
      //   "priority": 90,
      //   "acceptsArchives": true,
      //   "maxUsageMB": 0,
      //   "accounts": [{
      //     "name": "primary",
      //     "email": "vandaniel1994usa@gmail.com",
      //     "rootPath": "bucket/all-for-one-drive",
      //     "options": {
      //       "provider": "AWS",
      //       "access_key_id": "ACCESS_KEY",
      //       "secret_access_key": "SECRET_KEY",
      //       "region": "REGION",
      //       "endpoint": ""
      //     }
      //   }]
      // },
      // Backblaze B2
      // {
      //   "name": "backblaze-b2",
      //   "type": "b2",
      //   "echelon": 1,
      //   "priority": 4,
      //   "acceptsArchives": true,
      //   "maxUsageMB": 9900,
      //   "accounts": [{
      //     "name": "all-for-one-key",
      //     "email": "vandaniel1994usa@gmail.com",
      //     "rootPath": "all-for-one", // bucket name
      //     "options": {
      //       "account": "APPLICATION_KEY_ID",
      //       "key": "APPLICATION_KEY"
      //     }
      //   }]
      // },
      { // Cloudinary: https://console.cloudinary.com/pm/developer-dashboard ; plaintext secret, программа делает --obscure
        "name": "cloudinary",
        "type": "cloudinary",
        "echelon": 3,
        "priority": 1,
        "acceptsArchives": false, // JPEG/MP4 напрямую, архивы не принимает
        "accounts": [
          {
            "name": "primary",
            "email": "vandaniel1994usa@gmail.com", // только для человека; программа не использует
            "options": {
              "cloud_name": "CLOUDINARY_CLOUD_NAME",
              "api_key": "CLOUDINARY_API_KEY",
              "api_secret": "CLOUDINARY_API_SECRET",
              "upload_prefix": "",
              "upload_preset": ""
            }
          }
        ]
      }
      // Azure Blob / Files / GCS / Oracle / Swift — та же форма, другие type/options
      // WebDAV: Nextcloud, ownCloud, SharePoint, Fastmail
      // {
      //   "name": "webdav-storage",
      //   "type": "webdav",
      //   "echelon": 2,
      //   "priority": 70,
      //   "acceptsArchives": true,
      //   "accounts": [{
      //     "name": "primary",
      //     "email": "vandaniel1994usa@gmail.com",
      //     "rootPath": "all-for-one-drive",
      //     "options": {
      //       "url": "https://cloud.example.com/remote.php/dav/files/user/",
      //       "vendor": "nextcloud",
      //       "user": "USER",
      //       "pass": "PASSWORD"
      //     }
      //   }]
      // },
      // Логин/пароль: Mega, Proton Drive, OpenDrive, Mail.ru, FTP, SMB, SFTP, Seafile
      // {
      //   "name": "mega",
      //   "type": "mega",
      //   "echelon": 1,
      //   "priority": 1,
      //   "acceptsArchives": true,
      //   "accounts": [{
      //     "name": "personal",
      //     "email": "vandaniel1994usa@gmail.com",
      //     "rootPath": "",
      //     "twoFactor": { // только если на аккаунте включён 2FA
      //       "secret": "BASE32_TOTP_SECRET",
      //       "outputFile": "./mega-personal.otp",
      //       "rcloneOption": "2fa"
      //     },
      //     "options": {
      //       "user": "EMAIL",
      //       "pass": "PASSWORD" // plaintext; createRcloneConfig передаёт --obscure
      //     }
      //   }]
      // }
      // Поддерживаются все backend-ы текущей rclone; password-поля можно задавать открытым текстом
    ]
  }
}
