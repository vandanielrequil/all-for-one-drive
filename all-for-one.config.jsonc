{
  // Подготовка фотографий перед загрузкой в хранилища.
  "imageConverter": {
    // Пути считаются относительно этого файла.
    "inputDir": "./input",
    "outputDir": "./output",
    // Изображения меньше этого размера не увеличиваются.
    "maxDimension": 2560,
    // Допустимый диапазон JPEG quality: 1–100.
    "quality": 83
  }
}
